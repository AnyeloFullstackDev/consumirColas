PORT=16000

# RabbitMQ Broker
RABBIT_HOST=localhost
RABBIT_PORT=5672
RABBIT_USER=guest
RABBIT_PASSWORD=guest
RABBIT_VHOST=/

# Colas por defecto
DEFAULT_QUEUE_IN=mi_cola_entrada
DEFAULT_QUEUE_OUT=mi_cola_respuesta

# API Key opcional (se inyecta en el payload si no se especifica en la llamada)
RABBIT_API_KEY=tu-api-key-aqui
