{
    "compilerOptions": {
        "target": "esnext",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "rootDir": "./src",
        "outDir": "./dist",
        "strict": true,
        "declaration": true,
        "declarationMap": true,
        "skipLibCheck": true
    },
    "include": ["src/**/*"]
}